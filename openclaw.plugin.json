{
  "id": "openclaw-max",
  "name": "MAX",
  "description": "MAX messenger channel plugin (max.ru Bot API via platform-api2.max.ru, long polling or webhook)",
  "version": "0.7.3",
  "categories": [
    "channels"
  ],
  "channels": [
    "max"
  ],
  "channelConfigs": {
    "max": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "definitions": {
          "allowList": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "groupConfig": {
            "type": "object",
            "properties": {
              "requireMention": {
                "type": "boolean"
              },
              "tools": {
                "type": "object"
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "enabled": {
                "type": "boolean"
              },
              "allowFrom": {
                "$ref": "#/definitions/allowList"
              },
              "systemPrompt": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "accountConfig": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "markdown": {
                "type": "object"
              },
              "botToken": {
                "type": "string"
              },
              "tokenFile": {
                "type": "string"
              },
              "dmPolicy": {
                "type": "string",
                "enum": [
                  "pairing",
                  "allowlist",
                  "open",
                  "disabled"
                ],
                "default": "pairing"
              },
              "allowFrom": {
                "$ref": "#/definitions/allowList"
              },
              "groupAllowFrom": {
                "$ref": "#/definitions/allowList"
              },
              "groupPolicy": {
                "type": "string",
                "enum": [
                  "allowlist",
                  "open",
                  "disabled"
                ],
                "default": "allowlist"
              },
              "groups": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/definitions/groupConfig"
                }
              },
              "transport": {
                "type": "string",
                "enum": [
                  "polling",
                  "webhook"
                ],
                "description": "Update transport. Default: webhook when webhookUrl is set, otherwise polling. MAX does not serve long polling while a webhook subscription exists."
              },
              "webhookUrl": {
                "type": "string",
                "description": "Public HTTPS URL (port 443, trusted CA) MAX posts updates to; its path is served on the gateway HTTP server."
              },
              "webhookSecret": {
                "type": "string",
                "description": "X-Max-Bot-Api-Secret value, 5-256 of A-Z a-z 0-9 _ -. Prefer webhookSecretFile; generated and kept in the account state file when neither is set."
              },
              "webhookSecretFile": {
                "type": "string",
                "description": "File holding the webhook secret (like tokenFile)."
              },
              "webhookPath": {
                "type": "string",
                "description": "Gateway route path when it differs from the webhookUrl pathname (default: webhookUrl pathname, else /max/webhook)."
              },
              "historyLimit": {
                "type": "integer",
                "minimum": 0
              },
              "dmHistoryLimit": {
                "type": "integer",
                "minimum": 0
              },
              "dms": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "historyLimit": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                }
              },
              "textChunkLimit": {
                "type": "integer",
                "minimum": 1
              },
              "blockStreaming": {
                "type": "boolean"
              },
              "streamMode": {
                "type": "string",
                "enum": [
                  "off",
                  "partial",
                  "block"
                ]
              },
              "blockStreamingCoalesce": {
                "type": "object",
                "properties": {
                  "minChars": {
                    "type": "integer"
                  },
                  "maxChars": {
                    "type": "integer"
                  },
                  "idleMs": {
                    "type": "integer"
                  }
                },
                "additionalProperties": false
              },
              "responsePrefix": {
                "type": "string"
              },
              "mediaMaxMb": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "mediaMaxCount": {
                "type": "integer",
                "minimum": 1,
                "default": 12,
                "description": "Most media attachments (images, stickers, video, audio, files) downloaded per inbound message, forwarded ones included; the agent gets a note about the rest. Size is limited separately by mediaMaxMb. Named accounts inherit the channel-level value."
              },
              "markSeen": {
                "type": "boolean"
              },
              "actionScope": {
                "type": "string",
                "enum": [
                  "admitted",
                  "current",
                  "off"
                ],
                "default": "admitted",
                "description": "Chats message-tool actions (send, sendAttachment, sticker, edit, delete, pin, unpin) may act in. admitted: the current chat, owner requests and chats admitted by dmPolicy/allowFrom/pairing and groupPolicy/groups; current: non-owner turns only in their own chat; off: no plugin check."
              },
              "notify": {
                "type": "boolean",
                "default": true,
                "description": "Default push notification for sent messages (MAX notify). false sends silently; an explicit value of the call (core silent flag, channelData.max.notify) wins. MAX channels always notify. Named accounts inherit the channel-level value."
              },
              "disableLinkPreview": {
                "type": "boolean",
                "default": false,
                "description": "Default: send messages without link previews (MAX disable_link_preview); channelData.max.disableLinkPreview overrides it per message. Named accounts inherit the channel-level value."
              },
              "actions": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "pairing",
                        "allowlist",
                        "open"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        "allOf": [
          {
            "$ref": "#/definitions/accountConfig"
          }
        ],
        "properties": {
          "accounts": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/accountConfig"
            }
          },
          "commands": {
            "type": "array",
            "description": "Bot commands registered on start via PATCH /me/commands (replaces the whole list, max 32).",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 64
                },
                "description": {
                  "type": "string",
                  "maxLength": 128
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            "maxItems": 32
          },
          "defaultAccount": {
            "type": "string"
          }
        }
      },
      "label": "MAX",
      "description": "MAX messenger channel (max.ru Bot API)."
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}
