{
  "id": "openclaw-max",
  "name": "MAX",
  "description": "MAX messenger channel plugin (max.ru Bot API via platform-api2.max.ru, long polling or webhook)",
  "version": "0.7.3",
  "categories": [
    "channels"
  ],
  "channels": [
    "max"
  ],
  "channelConfigs": {
    "max": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "definitions": {
          "allowList": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "groupConfig": {
            "type": "object",
            "properties": {
              "requireMention": {
                "type": "boolean"
              },
              "tools": {
                "type": "object"
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "enabled": {
                "type": "boolean"
              },
              "allowFrom": {
                "$ref": "#/definitions/allowList"
              },
              "systemPrompt": {
                "type": "string"
              },
              "disableAudioPreflight": {
                "type": "boolean",
                "description": "Do not transcribe a captionless voice message to look for a configured mention pattern in this group."
              }
            },
            "additionalProperties": false
          },
          "accountConfig": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "markdown": {
                "type": "object"
              },
              "botToken": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "source": {
                            "type": "string",
                            "const": "env"
                          },
                          "provider": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                          },
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                          }
                        },
                        "required": [
                          "source",
                          "provider",
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "source": {
                            "type": "string",
                            "const": "store"
                          },
                          "provider": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                          },
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                          }
                        },
                        "required": [
                          "source",
                          "provider",
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "source": {
                            "type": "string",
                            "const": "file"
                          },
                          "provider": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                          },
                          "id": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "source",
                          "provider",
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "source": {
                            "type": "string",
                            "const": "exec"
                          },
                          "provider": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                          },
                          "id": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "source",
                          "provider",
                          "id"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                ],
                "description": "MAX Bot API token, or a SecretRef to it ({ source: env|file|exec|store, provider, id }) resolved by the gateway before the account starts. Alternatives: tokenFile, MAX_BOT_TOKEN (default account)."
              },
              "tokenFile": {
                "type": "string"
              },
              "dmPolicy": {
                "type": "string",
                "enum": [
                  "pairing",
                  "allowlist",
                  "open",
                  "disabled"
                ],
                "description": "Who may message the bot in direct chats (default pairing). Named accounts inherit the channel-level value."
              },
              "allowFrom": {
                "$ref": "#/definitions/allowList"
              },
              "groupAllowFrom": {
                "$ref": "#/definitions/allowList"
              },
              "groupPolicy": {
                "type": "string",
                "enum": [
                  "allowlist",
                  "open",
                  "disabled"
                ],
                "description": "Which group chats the bot answers in (default allowlist: only chats listed in groups). Named accounts inherit the channel-level value."
              },
              "groups": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/definitions/groupConfig"
                }
              },
              "mentionPatterns": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "allow",
                      "deny"
                    ]
                  },
                  "allowIn": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "denyIn": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false,
                "description": "Where core mention patterns (messages.groupChat / agent groupChat mentionPatterns) apply in MAX groups: mode allow (default) or deny, with allowIn / denyIn group chat ids."
              },
              "transport": {
                "type": "string",
                "enum": [
                  "polling",
                  "webhook"
                ],
                "description": "Update transport. Default: webhook when webhookUrl is set, otherwise polling. MAX does not serve long polling while a webhook subscription exists."
              },
              "webhookUrl": {
                "type": "string",
                "description": "Public HTTPS URL (port 443, trusted CA) MAX posts updates to; its path is served on the gateway HTTP server."
              },
              "webhookSecret": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "source": {
                            "type": "string",
                            "const": "env"
                          },
                          "provider": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                          },
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                          }
                        },
                        "required": [
                          "source",
                          "provider",
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "source": {
                            "type": "string",
                            "const": "store"
                          },
                          "provider": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                          },
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                          }
                        },
                        "required": [
                          "source",
                          "provider",
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "source": {
                            "type": "string",
                            "const": "file"
                          },
                          "provider": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                          },
                          "id": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "source",
                          "provider",
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "source": {
                            "type": "string",
                            "const": "exec"
                          },
                          "provider": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                          },
                          "id": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "source",
                          "provider",
                          "id"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                ],
                "description": "X-Max-Bot-Api-Secret value, 5-256 of A-Z a-z 0-9 _ -. Prefer webhookSecretFile; generated and kept in the account state file when neither is set. Accepts a SecretRef."
              },
              "webhookSecretFile": {
                "type": "string",
                "description": "File holding the webhook secret (like tokenFile)."
              },
              "webhookPath": {
                "type": "string",
                "description": "Gateway route path when it differs from the webhookUrl pathname (default: webhookUrl pathname, else /max/webhook)."
              },
              "historyLimit": {
                "type": "integer",
                "minimum": 0
              },
              "dmHistoryLimit": {
                "type": "integer",
                "minimum": 0
              },
              "dms": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "historyLimit": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                }
              },
              "textChunkLimit": {
                "type": "integer",
                "minimum": 1
              },
              "blockStreaming": {
                "type": "boolean"
              },
              "streamMode": {
                "type": "string",
                "enum": [
                  "off",
                  "partial",
                  "block"
                ]
              },
              "streaming": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "off",
                      "partial",
                      "block",
                      "progress"
                    ]
                  },
                  "chunkMode": {
                    "type": "string",
                    "enum": [
                      "length",
                      "newline"
                    ]
                  },
                  "preview": {
                    "type": "object",
                    "properties": {
                      "chunk": {
                        "type": "object",
                        "properties": {
                          "minChars": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "maxChars": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "breakPreference": {
                            "anyOf": [
                              {
                                "type": "string",
                                "const": "paragraph"
                              },
                              {
                                "type": "string",
                                "const": "newline"
                              },
                              {
                                "type": "string",
                                "const": "sentence"
                              }
                            ]
                          }
                        },
                        "additionalProperties": false
                      },
                      "toolProgress": {
                        "type": "boolean"
                      },
                      "commandText": {
                        "type": "string",
                        "enum": [
                          "raw",
                          "status"
                        ]
                      }
                    },
                    "additionalProperties": false
                  },
                  "progress": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "boolean",
                            "const": false
                          }
                        ]
                      },
                      "labels": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "maxLines": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "maxLineChars": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "toolProgress": {
                        "type": "boolean"
                      },
                      "commandText": {
                        "type": "string",
                        "enum": [
                          "raw",
                          "status"
                        ]
                      },
                      "commentary": {
                        "type": "boolean"
                      },
                      "narration": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  },
                  "block": {
                    "type": "object",
                    "properties": {
                      "enabled": {
                        "type": "boolean"
                      },
                      "coalesce": {
                        "type": "object",
                        "properties": {
                          "minChars": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "maxChars": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "idleMs": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false,
                "description": "Core streaming settings; streaming.mode wins over streamMode. \"progress\" shows one turn-status message edited while the agent works (streaming.progress: label, labels, toolProgress, commandText, maxLines, maxLineChars) and deleted once the answer landed; \"partial\"/\"block\" as streamMode. Default off."
              },
              "blockStreamingCoalesce": {
                "type": "object",
                "properties": {
                  "minChars": {
                    "type": "integer"
                  },
                  "maxChars": {
                    "type": "integer"
                  },
                  "idleMs": {
                    "type": "integer"
                  }
                },
                "additionalProperties": false
              },
              "responsePrefix": {
                "type": "string"
              },
              "mediaMaxMb": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "webhookQueue": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "durable",
                      "memory"
                    ]
                  },
                  "maxPending": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "overflow": {
                    "type": "string",
                    "enum": [
                      "reject",
                      "drop"
                    ]
                  }
                },
                "additionalProperties": false,
                "description": "Webhook queue. mode \"durable\" (default): every accepted update is written to the plugin state directory before MAX gets its 200, so a gateway restart or crash does not lose it; handled updates are deleted. mode \"memory\": the 0.7 in-memory queue. maxPending (default 5000) bounds accepted but unhandled updates; when full, overflow \"reject\" (default) answers 503 so MAX redelivers later, \"drop\" acknowledges and drops."
              },
              "maxEventAgeMinutes": {
                "type": "integer",
                "minimum": 0,
                "description": "Messages, edits, button presses and bot_started older than this many minutes (by MAX event time) are skipped instead of answered, so after a long outage the bot does not reply to hours-old messages (webhook and the queue recovered after a restart). Default 60; 0 answers any age."
              },
              "mediaMaxCount": {
                "type": "integer",
                "minimum": 1,
                "description": "Most media attachments (images, stickers, video, audio, files) downloaded per inbound message (default 12), forwarded ones included; the agent gets a note about the rest. Size is limited separately by mediaMaxMb. Named accounts inherit the channel-level value."
              },
              "markSeen": {
                "type": "boolean"
              },
              "actionScope": {
                "type": "string",
                "enum": [
                  "admitted",
                  "current",
                  "off"
                ],
                "description": "Chats message-tool actions (send, sendAttachment, sticker, edit, delete, pin, unpin) may act in. admitted (default): the current chat, owner requests and chats admitted by dmPolicy/allowFrom/pairing and groupPolicy/groups; current: non-owner turns only in their own chat; off: no plugin check. Named accounts inherit the channel-level value."
              },
              "notify": {
                "type": "boolean",
                "description": "Default push notification for sent messages (MAX notify, default true). false sends silently; an explicit value of the call (core silent flag, channelData.max.notify) wins. MAX channels always notify. Named accounts inherit the channel-level value."
              },
              "disableLinkPreview": {
                "type": "boolean",
                "description": "Default: send messages without link previews (MAX disable_link_preview, default false); channelData.max.disableLinkPreview overrides it per message. Named accounts inherit the channel-level value."
              },
              "apiBaseUrl": {
                "type": "string",
                "description": "MAX Bot API base URL (default https://platform-api2.max.ru), e.g. a test stand; a path prefix is kept. https only; http is accepted just for loopback hosts, so the bot token never travels unencrypted. A bad value stops the account at start with an error. Named accounts inherit the channel-level value."
              },
              "httpProxy": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "source": {
                            "type": "string",
                            "const": "env"
                          },
                          "provider": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                          },
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                          }
                        },
                        "required": [
                          "source",
                          "provider",
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "source": {
                            "type": "string",
                            "const": "store"
                          },
                          "provider": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                          },
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                          }
                        },
                        "required": [
                          "source",
                          "provider",
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "source": {
                            "type": "string",
                            "const": "file"
                          },
                          "provider": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                          },
                          "id": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "source",
                          "provider",
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "source": {
                            "type": "string",
                            "const": "exec"
                          },
                          "provider": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                          },
                          "id": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "source",
                          "provider",
                          "id"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                ],
                "description": "HTTP(S) proxy for all outbound MAX traffic of the account: Bot API calls, file uploads and media downloads, e.g. http://user:pass@proxy.example:3128. MAX TLS (Russian Trusted CA included) is verified inside the tunnel; loopback targets bypass the proxy. Credentials are never logged. Named accounts inherit the channel-level value; \"\" turns an inherited proxy off. Accepts a SecretRef (e.g. when the URL carries credentials)."
              },
              "actions": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "pairing",
                        "allowlist",
                        "open"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        "allOf": [
          {
            "$ref": "#/definitions/accountConfig"
          }
        ],
        "properties": {
          "accounts": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/accountConfig"
            }
          },
          "commands": {
            "type": "array",
            "description": "Bot commands registered on start via PATCH /me/commands (replaces the whole list, max 32).",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 64
                },
                "description": {
                  "type": "string",
                  "maxLength": 128
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            "maxItems": 32
          },
          "defaultAccount": {
            "type": "string"
          }
        }
      },
      "uiHints": {
        "botToken": {
          "label": "Bot token",
          "help": "MAX Bot API token or a SecretRef to it.",
          "sensitive": true
        },
        "webhookSecret": {
          "label": "Webhook secret",
          "sensitive": true,
          "advanced": true
        },
        "accounts.*.botToken": {
          "label": "Bot token",
          "help": "MAX Bot API token or a SecretRef to it.",
          "sensitive": true
        },
        "accounts.*.webhookSecret": {
          "label": "Webhook secret",
          "sensitive": true,
          "advanced": true
        },
        "apiBaseUrl": {
          "label": "API base URL",
          "placeholder": "https://platform-api2.max.ru",
          "advanced": true
        },
        "httpProxy": {
          "label": "HTTP proxy",
          "placeholder": "http://user:pass@proxy.example:3128",
          "sensitive": true,
          "advanced": true
        },
        "accounts.*.apiBaseUrl": {
          "label": "API base URL",
          "placeholder": "https://platform-api2.max.ru",
          "advanced": true
        },
        "accounts.*.httpProxy": {
          "label": "HTTP proxy",
          "placeholder": "http://user:pass@proxy.example:3128",
          "sensitive": true,
          "advanced": true
        }
      },
      "label": "MAX",
      "description": "MAX messenger channel (max.ru Bot API)."
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}
