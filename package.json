{
  "name": "@aspalagin/openclaw-max",
  "version": "0.8.2",
  "description": "MAX messenger (max.ru) channel for OpenClaw: private and group chats over webhook or long polling; media, voice messages with transcription and voice replies; inline keyboards and command menus; message edits and pins; several bot accounts",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "openclaw-channel",
    "max",
    "max.ru",
    "max-messenger",
    "max-bot-api",
    "messenger",
    "chatbot",
    "bot",
    "webhook",
    "long-polling",
    "voice-messages",
    "ai-agent"
  ],
  "license": "MIT",
  "author": {
    "name": "Arseniy Palagin",
    "url": "https://github.com/aspalagin"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aspalagin/openclaw-max.git"
  },
  "homepage": "https://github.com/aspalagin/openclaw-max#readme",
  "bugs": {
    "url": "https://github.com/aspalagin/openclaw-max/issues"
  },
  "scripts": {
    "build": "rm -rf dist-ts dist/src && tsc --noEmit false --noEmitOnError false --outDir dist-ts && mkdir -p dist/src && cp dist-ts/index.js dist-ts/setup-entry.js dist-ts/secret-contract-api.js dist/ && cp dist-ts/src/*.js dist/src/ && rm -f dist/src/*.test.js dist/src/test-setup.js",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "node --input-type=module ./scripts/test-api.mjs",
    "check:cycles": "node scripts/check-cycles.mjs",
    "schema:update": "node scripts/update-schema.mjs"
  },
  "files": [
    "dist/",
    "src/",
    "!src/**/*.test.ts",
    "!src/test-setup.ts",
    "!src/__fixtures__/",
    "assets/icon.png",
    "openclaw.plugin.json",
    "README.md",
    "README_EN.md",
    "SKILL.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "max",
      "label": "MAX",
      "selectionLabel": "MAX (max.ru)",
      "docsPath": "/channels/max",
      "docsLabel": "max",
      "blurb": "MAX messenger channel (max.ru Bot API).",
      "configuredState": {
        "env": {
          "anyOf": [
            "MAX_BOT_TOKEN"
          ]
        }
      }
    },
    "compat": {
      "pluginApi": ">=2026.9.6",
      "minGatewayVersion": "2026.9.6"
    },
    "build": {
      "openclawVersion": "2026.9.6",
      "pluginSdkVersion": "2026.9.6"
    }
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "openclaw": "^2026.9.6",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.6"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": false
    }
  },
  "dependencies": {
    "undici": "^8.7.0",
    "zod": "^4.4.3"
  }
}
